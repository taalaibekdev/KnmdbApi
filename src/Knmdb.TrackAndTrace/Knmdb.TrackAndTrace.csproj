<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Knmdb.TrackAndTrace</RootNamespace>
    <AssemblyName>Knmdb.TrackAndTrace</AssemblyName>
    <PackageId>Knmdb.TrackAndTrace</PackageId>
    <Title>KNMDB Track and Trace API SDK</Title>
    <Description>Кроссплатформенный SDK и DI-сервис для Track and Trace API системы KNMDB / KNDDB: аутентификация OAuth2 (password / refresh_token), автопродление токена, смена пользователя «на ходу», все методы API, типизированные модели и перечисления. Один пакет подключается в ASP.NET Core, .NET MAUI, WPF, WinForms, Avalonia и консольные приложения на .NET 10.</Description>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\*.md" Pack="true" PackagePath="docs\" />
    <EmbeddedResource Include="OpenApi\knddb-track-and-trace-v1.json" LogicalName="Knmdb.TrackAndTrace.OpenApi.knddb-track-and-trace-v1.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Knmdb.TrackAndTrace.Tests" />
  </ItemGroup>

</Project>
