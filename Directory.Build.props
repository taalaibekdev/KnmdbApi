<Project>

  <PropertyGroup>
    <!-- Все проекты решения нацелены на .NET 10. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Строгие правила качества: ошибки компилятора, анализаторы AOT/trimming
         и корректности использования API включены на уровне ошибок.
         Правила стиля и микрооптимизаций настроены в .editorconfig. -->
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;KNMDB0001</NoWarn>

    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Метаданные NuGet-пакетов -->
  <PropertyGroup>
    <VersionPrefix>1.0.1</VersionPrefix>
    <Authors>KNMDB</Authors>
    <Company>KNMDB</Company>
    <Product>KNMDB Track and Trace API SDK</Product>
    <Copyright>Copyright (c) KNMDB</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://testndbapi.med.kg</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>ru</NeutralLanguage>
    <PackageTags>knddb;knmdb;track-and-trace;лекарства;маркировка;sdk;api-client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

</Project>
